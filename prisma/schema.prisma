generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Job {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customerName String
  address      String
  postcode     String
  lat          Float?
  lng          Float?
  type         String   // "delivery" | "collection"
  notes        String?
  status       String   @default("pending") // "pending" | "in_progress" | "done" | "cancelled"
  jobDate      DateTime @default(now())
  sortOrder    Int      @default(0)
  locked       Boolean  @default(false)
}

model Depot {
  id       Int    @id @default(1)
  address  String
  postcode String
  lat      Float?
  lng      Float?
}
